{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the file viewer",
  "windows": ["main", "viewer"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "dialog:allow-save",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPCACHE/**" }] }
  ]
}
